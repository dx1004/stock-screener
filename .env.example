# Database Configuration
# For PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/stock_screener

# For local testing with SQLite (no installation required)
# DATABASE_URL=sqlite:///./stock_screener.db

# Logging Configuration
LOG_LEVEL=INFO

# Cache Configuration
CACHE_DIR=./data/cache
CACHE_EXPIRY_HOURS=24

# Market data (Alpaca is the primary price-data provider; Yahoo is the fallback)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_API_SECRET=your-alpaca-api-secret

# SEC EDGAR requires an identifying User-Agent with real contact information.
# It is not a credential and can be stored as a GitHub Actions repository variable.
SEC_EDGAR_USER_AGENT=Your Name your-email@example.com

# Optional: FMP is used only for selected buy candidates when --use-fmp is set.
FMP_API_KEY=your-fmp-api-key

# Email Notification Configuration
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_TO=recipient@example.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Slack Notification Configuration (optional)
# Option 1: Webhook URL (easier setup)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Option 2: Bot Token (more features)
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL=#stock-alerts

# Screening Configuration
SCREENING_TICKERS=AAPL,MSFT,GOOGL,AMZN,META,JPM,BAC,WMT,JNJ,XOM
SCREENING_TOP_N=10
SCREENING_MIN_SIGNAL=50

# Robinhood Integration (optional - read-only position tracking)
# Only username needed - password and SMS MFA are prompted interactively (never stored)
# ROBINHOOD_USERNAME=your-email@example.com
